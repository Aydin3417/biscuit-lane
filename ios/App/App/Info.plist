    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- armv7 is 32-bit; no device running a supported iOS has it, and
	     asking for it narrows the store listing for nothing. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Pawtika is played the tall way up. The web build shows a
	     rotate gate on a short landscape viewport; on a device that gate
	     should never be reachable, so the app is locked rather than the
	     player being told off for turning a phone. Matches the Android
	     activity's android:screenOrientation="portrait". -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<!-- Portrait-only on iPad is allowed only for an app that asks for the
	     whole screen; without this key App Store Connect refuses the upload
	     for not supporting Split View in every orientation. -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<!-- No encryption beyond what iOS itself does for HTTPS to the store,
	     which is exempt; saying so here skips the export question on every
	     build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- AdMob, rewarded video only (src/js/19-ads.js). The app id of
	     "Pawtika" (iOS) in AdMob; its rewarded unit is AD_UNITS.ios.
	     Without this key the SDK refuses to start. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3062307440336080~6761949460</string>
	<!-- Apple's tracking prompt, asked at launch straight after Google's
	     consent form and before any ad is loaded (App Review, 5.1.2(i),
	     30 Oct 2026). The Turkish text is in tr.lproj/InfoPlist.strings. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Pawtika only shows a video when you ask for one. Allowing tracking lets those videos be more relevant to you; saying no changes nothing else in the game.</string>
	<!-- Google's own attribution network first, then the third-party
	     buyers Google lists for AdMob (developers.google.com/admob/ios/
	     3p-skadnetworks, read 30 Oct 2026): a buyer missing from this
	     list cannot be credited for an install on iOS, so it bids lower
	     or not at all, and fill on iPhone is what pays for the videos. -->
